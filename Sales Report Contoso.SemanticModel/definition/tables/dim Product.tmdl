				    #"Merged Queries" = Table.NestedJoin(#"Expanded DimProductSubcategory", {"ProductCategoryKey"}, #"dim ProductCategory", {"ProductCategoryKey"}, "dim ProductCategory", JoinKind.LeftOuter),
