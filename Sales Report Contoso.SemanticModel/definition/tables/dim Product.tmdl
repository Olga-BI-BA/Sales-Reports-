				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns",{"ProductKey", "Product", "Category", "Subcategory", "Manufacturer", "Brand", "Class", "ColorID", "Color", "StockTypeID", "StockType", "UnitCost", "UnitPrice", "AvailableForSaleDate"}),
