	column 'ABC 2025' =
			
			VAR LastYear = MAXX ( ALL ( 'ABC XYZ Classification' ), [Year] )-1
			VAR Result =
			    LOOKUPVALUE (
			        'ABC XYZ Classification'[ABC Class],
			        'ABC XYZ Classification'[ProductKey], 'dim Product'[ProductKey],
			        'ABC XYZ Classification'[Year], LastYear
			    )
			RETURN
			    COALESCE ( Result, "No Sales" )
		lineageTag: e6429abc-d796-4fd2-b962-efbd80b3198f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'XYZ 2025' =
			
			VAR LastYear = MAXX ( ALL ( 'ABC XYZ Classification' ), [Year] )-1
			VAR Result =
			    LOOKUPVALUE (
			        'ABC XYZ Classification'[XYZ Class],
			        'ABC XYZ Classification'[ProductKey], 'dim Product'[ProductKey],
			        'ABC XYZ Classification'[Year], LastYear
			    )
			RETURN
			    COALESCE ( Result, "No Sales" )
		lineageTag: c1aff4db-e397-467f-af70-daff1f57ef76
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

