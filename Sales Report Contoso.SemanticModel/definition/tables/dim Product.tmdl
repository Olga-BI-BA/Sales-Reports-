	column 'Available Year' = YEAR ( 'dim Product'[AvailableForSaleDate] )
		lineageTag: 045fcb59-11cd-4aca-bf30-19015357bfa2
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Last Sale Year' =
			
			CALCULATE ( MAX ( 'dim Calendar'[Year] ), 'fact Sales'[SalesQuantity] > 0 )
		lineageTag: dbf6de85-d1c5-4190-9005-7df18ccc61e6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'ABC XYZ 2025' =
			
			VAR BaseYear = MAXX ( ALL ( 'ABC XYZ Classification' ), 'ABC XYZ Classification'[Year] )-1
			VAR AvailYr  = YEAR ( 'dim Product'[AvailableForSaleDate] )
			VAR LastYr   = 'dim Product'[Last Sale Year]-1
			VAR ClassBase =
			    LOOKUPVALUE (
			        'ABC XYZ Classification'[ABC XYZ],
			        'ABC XYZ Classification'[ProductKey], 'dim Product'[ProductKey],
			        'ABC XYZ Classification'[Year], BaseYear
			    )
			VAR Gap = BaseYear - LastYr
			RETURN
			    SWITCH (
			        TRUE (),
			        AvailYr > BaseYear, "Not launched",
			        NOT ISBLANK ( ClassBase ) && AvailYr = BaseYear, "New " & ClassBase,
			        NOT ISBLANK ( ClassBase ), ClassBase,
			        ISBLANK ( LastYr ), "Listed, no sales",
			        Gap = 1, "Dormant 1y",
			        Gap <= 3, "Dormant " & Gap & "y",
			        "Dormant 4y+"
			    )
		lineageTag: 695d3498-8a5f-4649-8682-caecbf333acf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'First Sale Year' =
			
			CALCULATE ( MIN ( 'dim Calendar'[Year] ), 'fact Sales'[SalesQuantity] > 0 )
		formatString: 0
		lineageTag: fb3cc7ad-7d35-4a5c-95f2-c54e04e32c58
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'CV Qty Col 2025' = CALCULATE ( [CV Qty], 'dim Calendar'[Year] = 2025 )
		formatString: 0.000
		lineageTag: 2aabb39f-9250-4d93-9f87-9b721030c9be
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"dim Product","TableItemName":"CV Qty Col 2025 (bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'CV Qty Col 2025 (bins)' =
			IF(
				ISBLANK('dim Product'[CV Qty Col 2025]),
				BLANK(),
				IF(
					'dim Product'[CV Qty Col 2025] >= 0,
					ROUNDDOWN('dim Product'[CV Qty Col 2025] / 0.1, 0) * 0.1,
					ROUNDUP('dim Product'[CV Qty Col 2025] / 0.1, 0) * 0.1
				)
			)
		formatString: 0.000
		lineageTag: 38ab819b-0cd1-41d9-8751-51ec6738405a
		summarizeBy: none

