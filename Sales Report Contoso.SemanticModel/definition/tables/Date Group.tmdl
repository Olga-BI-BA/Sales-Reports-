				DATATABLE(
				    "Date Group", STRING,
				    "Sort Order", INTEGER,
				    {
				        {"Daily", 1},
				        {"DailyPY", 2},
				        {"WTD", 3},
				        {"WTDPY", 4},
				        {"MTD", 5},
				        {"MTDPY", 6},
				        {"QTD", 7},
				        {"QTDPY", 8},
				        {"YTD", 9},
				        {"YTDPY", 10}
				    }
				)

	annotation PBI_Id = ababc81f3dbf43dda6fa0bc6d81fd099

