	column 'Units Sold'
		isHidden
		lineageTag: 0e9740ba-d2b1-4bf3-b320-77e4cb61fd90
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Units Sold]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'XYZ Classification' = calculated
		mode: import
		source = ```
				
				VAR MonthlyDemand =
				    ADDCOLUMNS(
				        SUMMARIZE(
				            'fact Sales',
				            'dim Calendar'[Year],
				            'fact Sales'[ProductKey],
				            'dim Calendar'[Month]
				        ),
				        "Monthly Qty", 
				            CALCULATE(
				                SUM('fact Sales'[SalesQuantity]) - SUM('fact Sales'[ReturnQuantity])
				            )
				    )
				VAR YearProductStats =
				    ADDCOLUMNS(
				        SUMMARIZE(MonthlyDemand, [Year], [ProductKey]),
				        "Units Sold", 
				            CALCULATE(
				                SUM('fact Sales'[SalesQuantity]) - SUM('fact Sales'[ReturnQuantity])
				            ),
				        "Avg Sales",
				            VAR curYear = [Year]
				            VAR curProduct = [ProductKey]
				            VAR filteredMonths = 
				                FILTER(MonthlyDemand, [Year] = curYear && [ProductKey] = curProduct)
				            RETURN AVERAGEX(filteredMonths, [Monthly Qty]),
				        "StdDev Sales",
				            VAR curYear = [Year]
				            VAR curProduct = [ProductKey]
				            VAR filteredMonths = 
				                FILTER(MonthlyDemand, [Year] = curYear && [ProductKey] = curProduct)
				            RETURN STDEVX.P(filteredMonths, [Monthly Qty]),
				        "Months With Sales",
				            VAR curYear = [Year]
				            VAR curProduct = [ProductKey]
				            RETURN 
				                COUNTROWS(
				                    FILTER(MonthlyDemand, [Year] = curYear && [ProductKey] = curProduct)
				                )
				    )
				VAR WithCV =
				    ADDCOLUMNS(
				        YearProductStats,
				        "CV", DIVIDE([StdDev Sales], [Avg Sales])
				    )
				VAR WithClass =
				    ADDCOLUMNS(
				        WithCV,
				        "Classification",
				        SWITCH(
				            TRUE(),
				            [Months With Sales] < 3, "Z",
				            ISBLANK([CV]), "Z",
				            [CV] <= 0.10, "X",
				            [CV] <= 0.25, "Y",
				            "Z"
				        )
				    )
				RETURN WithClass
				```

	annotation PBI_Id = 2964f3aee14e44549fac08c381eaa20d

