	measure 'Forecast Net Revenue MONTH' = ```
			
			
			VAR WorkingDaysPlanned = [Number of Working Days in Month] 
			VAR _NR_MTD = CALCULATE([Net Revenue], DATESMTD('dim Calendar'[Date]))
			VAR Result = 
			
			    DIVIDE ( _NR_MTD, [Number of Days Elapsed MTD] ) * WorkingDaysPlanned 
			
			RETURN 
			
			    Result 
