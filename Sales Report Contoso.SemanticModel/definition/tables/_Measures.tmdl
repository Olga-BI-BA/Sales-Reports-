	measure 'Dymanic SubTitle Daily Cockpit' = ```
			
			
			VAR MacroText =
			    IF(
			        HASONEVALUE('dim SalesTerritory'[SalesTerritoryGroup]),
			        SELECTEDVALUE('dim SalesTerritory'[SalesTerritoryGroup]),
			        --"All Macroregions" 
			        ""
			    )
			
			VAR CountryText =
			    IF(
			        HASONEVALUE('dim SalesTerritory'[SalesTerritoryCountry]),
			        SELECTEDVALUE('dim SalesTerritory'[SalesTerritoryCountry]),
			        --"All countries"
			        ""
			    )
			
			VAR ChannelText =
			    IF(
			        HASONEVALUE('dim Channel'[ChannelName]),
			        SELECTEDVALUE('dim Channel'[ChannelName]),
			        --"All channels"
			        ""
			    )
			
			VAR SubcategoryText =
			    IF(
			        HASONEVALUE('dim Product'[Category]),
			        SELECTEDVALUE('dim Product'[Category]),
			        --"All subcategories"
			        ""
			    )
			
			    VAR MacroBlock =
			    IF(
			        MacroText <> "",
			        " • " & MacroText,
			        ""
			    )
			
			VAR CountryBlock =
			    IF(
			        CountryText <> "",
			        " • " & CountryText,
			        ""
			    )
			
			VAR ChannelBlock =
			    IF(
			        ChannelText <> "",
			        " • " & ChannelText,
			        ""
			    )
			
			VAR SubcategoryBlock =
			    IF(
			        SubcategoryText <> "",
			        " • " & SubcategoryText,
			        ""
			    )
			
			VAR Result =   MacroBlock
			    & CountryBlock
			    & ChannelBlock
			    & SubcategoryBlock
			RETURN
			    if(Result ="", "Overall Daily Performance", Result)
			
			
			```
		displayFolder: Viz Dynamic Titles
		lineageTag: f9f6535e-a140-48f0-9a9e-ad7ff1c331e9

