	measure 'Gross Profit MPY' =
			
			VAR _SelectedDate =
			   [Last Sale Date]
			
			VAR _PYlastdate =
			    EDATE(_SelectedDate, -12)
			
			VAR _PYlastmonthday =
			    EOMONTH(_PYlastdate, 0)
			
			VAR _PY_startOfMonth =
			    DATE(
			        YEAR(_PYlastdate),
			        MONTH(_PYlastdate),
			        1
			    )
			
			RETURN
			    CALCULATE(
			        [Gross Profit],
			        REMOVEFILTERS('dim Calendar'),
			        DATESBETWEEN(
			            'dim Calendar'[Date],
			            _PY_startOfMonth,
			            _PYlastmonthday
			        )
			    )
		displayFolder: Sales Analysis
		lineageTag: 85f7e078-3462-4c3c-b809-a52cde280e8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

