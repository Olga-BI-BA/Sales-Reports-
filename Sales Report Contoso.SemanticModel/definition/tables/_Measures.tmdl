	measure 'Scenario Quantity' = [Units Sold]*(1+[Demand Increase Scenario Value])
		displayFolder: Scenarios
		lineageTag: edb8fab6-d384-447e-8892-97458b0d8cb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scenario Price List Revenue' = ```
			
			SUMX(VALUES('fact Sales'[ProductKey]), 
			var CurrentUnits = [Units Sold]
			var ScenarioUnits = CurrentUnits*(1+ [Demand Increase Scenario Value])
			var UnitPrice = CALCULATE(MAX('fact Sales'[UnitPrice]))
			Return 
			ScenarioUnits*UnitPrice
			)
			```
		formatString: #,0.###############\ "Br";-#,0.###############\ "Br";#,0.###############\ "Br"
		displayFolder: Scenarios
		lineageTag: a99505c3-019d-46d9-bae3-279d996c1a81

		annotation PBI_FormatHint = {"currencyCulture":"ru-BY"}

	measure 'Scenario Net Revenue' = [Scenario Price List Revenue]*(1-[Discount Scenario Value])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Scenarios
		lineageTag: c4f998ef-e42d-45f7-b230-c1bc45df8106

	measure 'Scenario COGS' = ```
			
			SUMX(VALUES('fact Sales'[ProductKey]), 
			var CurrentUnits = [Units Sold]
			var ScenarioUnits = CurrentUnits*(1+ [Demand Increase Scenario Value])
			var UnitCost = CALCULATE(MAX('fact Sales'[UnitCost]))
			var UnitCostScenario = UnitCost*(1+[Unit Cost Scenario Value])
			Return 
			ScenarioUnits*UnitCostScenario
			)
			```
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Scenarios
		lineageTag: 472c0753-dd33-4d92-81f9-cca22fe08aa7

