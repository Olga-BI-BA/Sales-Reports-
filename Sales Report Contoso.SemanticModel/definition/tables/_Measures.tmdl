		displayFolder: Scenarios
		lineageTag: 6ad395a2-68f5-455d-a206-4e5447ffd54f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Scenario Gross Margin %' = DIVIDE([Scenario Gross Profit], [Scenario Net Revenue])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Scenarios
		lineageTag: bce72a90-e283-4cdc-a1f0-1817d7971fa2

	measure 'Top 10 Products Revenue' = ```
			
			Sumx(
			    TOPN(
			    10,
			    ALLSELECTED('dim Product'[Product]),
			    [Net Revenue]
			), [Net Revenue])
			
			
			
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Basic Sales measures
		lineageTag: 675e388c-a577-4838-9adf-cc686051ff1d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'vs Net Revenue MoM' = ```
			
			var _CM = [Net Revenue]
			var _PM = CALCULATE([Net Revenue],DATEADD('dim Calendar'[Date], -1,MONTH))
			VAR _diff = DIVIDE(_CM-_PM,_PM)
			RETURN
			        _diff
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Sales Analysis
		lineageTag: 0a0cc53a-aaa2-4328-a0d3-ddbfa2dd3a46

	measure 'viz YoY Net Revenue' = ```
			
			var _CY = [Net Revenue]
			var _PY = CALCULATE([Net Revenue],DATEADD('dim Calendar'[Date],-1,YEAR))
			VAR _diff = DIVIDE(_CY-_PY,_PY)
			VAR _format = SWITCH(TRUE(),
			                      _diff > 0, UNICHAR(11165) & " " & FORMAT (_diff, "0.00%"), 
			                      _diff < 0, UNICHAR(11167) & " " & FORMAT ( _diff, "0.00%"),
			                       FORMAT ( _diff, "0.00%")
			                    )
			RETURN
			        _format
			
			```
		displayFolder: Viz Cards
		lineageTag: 590ecfe4-4dda-4894-8d9d-565a36647298

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vs PM Net Revenue CF' = ```
			
			var _CY = [Net Revenue]
			var _PY = CALCULATE([Net Revenue],DATEADD('dim Calendar'[Date],-1,MONTH))
			VAR _diff = DIVIDE(_CY-_PY,_PY)
