	measure 'Dymanic SubTitle Products Page' = ```
			
			
			-- 1. MacroRegions
			
			VAR SelectedMacroTable = VALUES('dim SalesTerritory'[SalesTerritoryGroup])
			
			VAR MacroCount = COUNTROWS(SelectedMacroTable)
			
			VAR MacroText = 
			
			    SWITCH(
			        TRUE(),
			        NOT(ISFILTERED('dim SalesTerritory'[SalesTerritoryGroup])), "All Macroregions",
			        MacroCount = 1, SELECTEDVALUE('dim SalesTerritory'[SalesTerritoryGroup]),
			        MacroCount = 2, CONCATENATEX(
			            SelectedMacroTable,
			            'dim SalesTerritory'[SalesTerritoryGroup],
			            ", "
			        ),
			        MacroCount > 2, 
			            VAR Top2Macro = TOPN(
			                2,
			                SelectedMacroTable,
			                'dim SalesTerritory'[SalesTerritoryGroup],
			                ASC
			            )
			            RETURN
			                CONCATENATEX(
			                    Top2Macro,
			                    'dim SalesTerritory'[SalesTerritoryGroup],
			                    ", "
			                ) & ", etc.",
			        "All Macroregions"
			    )
			
			-- 2. Countries
			
			VAR SelectedCountriesTable = VALUES('dim SalesTerritory'[SalesTerritoryCountry])
			
			VAR CountriesCount = COUNTROWS(SelectedCountriesTable)
			
			VAR CountryText = 
			
			    SWITCH(
			        TRUE(),
			        NOT(ISFILTERED('dim SalesTerritory'[SalesTerritoryCountry])), "All countries",
			        CountriesCount = 1, SELECTEDVALUE('dim SalesTerritory'[SalesTerritoryCountry]), 
			        CountriesCount = 2, CONCATENATEX(
			            SelectedCountriesTable,
			            'dim SalesTerritory'[SalesTerritoryCountry],
			            ", "
			        ),
			        CountriesCount > 2, 
			            VAR Top2Countries = TOPN(
			                2,
			                SelectedCountriesTable,
			                'dim SalesTerritory'[SalesTerritoryCountry],
			                ASC
			            )
			            RETURN
			                CONCATENATEX(
			                    Top2Countries,
			                    'dim SalesTerritory'[SalesTerritoryCountry],
			                    ", "
			                ) & ", etc.", 
			        "All countries" 
			    )
			-- 3. Year
			
			VAR YearText =
			    IF(
			        HASONEVALUE('dim Calendar'[Year]),
			        FORMAT(
			            SELECTEDVALUE('dim Calendar'[Year]),
			            "0"
			        ),
			        "2023–2026"
			    )
			
			
			RETURN
			
			    " • " & MacroText
			    & " • " & CountryText
			    & " • " & YearText
			
			```
