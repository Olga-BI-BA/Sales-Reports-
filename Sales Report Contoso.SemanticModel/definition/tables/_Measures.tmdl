	measure 'Share of Gross Profit  Annual' =
			
			VAR ProductGP = [Gross Profit]
			VAR TotalGP =
			    CALCULATE (
			        [Gross Profit],
			        REMOVEFILTERS ( 'dim Product'),
			        ALLEXCEPT ( 'dim Calendar', 'dim Calendar'[Year])
			    )
			RETURN
			    DIVIDE ( ProductGP, TotalGP )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Viz ABC XYZ
		lineageTag: 038277fe-d43c-4df5-93be-88f0bd4bf9bf

	measure 'Share of Revenue Annual' =
			
			VAR ProductR = [Net Revenue]
			VAR TotalGP =
			    CALCULATE (
			        [Net Revenue],
			        REMOVEFILTERS ( 'dim Product'),
			        ALLEXCEPT ( 'dim Calendar', 'dim Calendar'[Year])
			    )
			RETURN
			    DIVIDE ( ProductR, TotalGP )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Viz ABC XYZ
		lineageTag: 78659851-a69d-42d4-a6ba-8004f1af09e0

	measure 'CV Qty' =
			
			VAR _MonthlyQty =
			    ADDCOLUMNS (
			        VALUES ( 'dim Calendar'[Year Month] ),
			        "QtyValue", CALCULATE ( SUM ( 'fact Sales'[SalesQuantity] ) ) + 0
			    )
			VAR _Avg =
			    AVERAGEX ( _MonthlyQty, [QtyValue] )
			VAR _SD =
			    STDEVX.P ( _MonthlyQty, [QtyValue] )
			RETURN
			    DIVIDE ( _SD, _Avg )
		displayFolder: Viz ABC XYZ
		lineageTag: 232ee384-1529-4a5c-9272-11c192446659

		annotation PBI_FormatHint = {"isGeneralNumber":true}

