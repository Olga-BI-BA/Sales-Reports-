table _Measures
	lineageTag: 698e02ab-3616-43ce-bf4b-e430d87ac465

	measure 'Gross Sales' = SUM('fact Sales'[SalesAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales Analysis
		lineageTag: f3ba420d-38dc-4aa7-b4e1-433742ba7d87

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure COGS = SUMX('fact Sales',('fact Sales'[SalesQuantity]-'fact Sales'[ReturnQuantity])*'fact Sales'[UnitCost])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Basic Sales measures
		lineageTag: dd33c6dc-cba3-4b49-9fbb-28579c3bb94b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Profit' = [Net Revenue]-[COGS]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Basic Sales measures
		lineageTag: 09e6a4da-8159-4458-bd45-48f275711465

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Margin' = DIVIDE([Gross Profit], [Net Revenue])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Basic Sales measures
		lineageTag: c6952000-a1f0-4f15-b9c4-02a385f17476

	measure 'Total Returns' = SUM('fact Sales'[ReturnAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Basic Sales measures
		lineageTag: 1b6c23e8-0ea5-4071-970c-9c06025a6c38

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Revenue' = [Gross Sales]-[Total Returns]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Basic Sales measures
		lineageTag: 4f22e505-98ac-4575-9571-7d95f231fb7c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Price List Revenue' = sumx('fact Sales','fact Sales'[UnitPrice]*('fact Sales'[SalesQuantity]-'fact Sales'[ReturnQuantity]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Basic Sales measures
		lineageTag: 66b779b4-852f-474f-a31a-754617d41a0f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Discount Amount' = SUM('fact Sales'[DiscountAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Basic Sales measures
		lineageTag: fc22a8dc-5e39-48d1-92d2-94b1d8d6b985

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Return Rate %' = DIVIDE(SUM('fact Sales'[ReturnQuantity]),SUM('fact Sales'[SalesQuantity]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Basic Sales measures
		lineageTag: 72e6fca6-334b-406d-8a2d-b6e8bd274685

	measure 'Discount Depth' = divide( [Total Discount Amount],[Price List Revenue])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Basic Sales measures
		lineageTag: ca56b70e-61c6-4d56-9aeb-ca8d49d15ae8

	measure 'Net Revenue PY' = CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('dim Calendar'[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales Analysis
		lineageTag: 8a785d6c-64ae-49eb-ae37-aec2bc8d0269

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YoY Revenue %' = DIVIDE([Net Revenue] - [Net Revenue PY], [Net Revenue PY])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Sales Analysis
		lineageTag: 6ea9ef5b-5fb9-456b-9abc-d0aa6e654e23

	measure 'Gross Profit PY' = CALCULATE([Gross Profit], SAMEPERIODLASTYEAR('dim Calendar'[Date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales Analysis
		lineageTag: d37427cf-b8ed-44fa-9133-3d1b1783b3c4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YoY Gross Profit, %' = DIVIDE([Gross Profit] - [Gross Profit PY], [Gross Profit PY])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Sales Analysis
		lineageTag: acebff38-8258-4689-b713-f7d32719e5d7

	measure 'Gross Margin PY' = CALCULATE([Gross Margin], SAMEPERIODLASTYEAR('dim Calendar'[Date]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Sales Analysis
		lineageTag: e070dd51-e2d9-4ff6-b304-d6943f02bd94

	measure 'YoY Margin pp' = ([Gross Margin] - [Gross Margin PY])*100
		formatString: 0.00
		displayFolder: Sales Analysis
		lineageTag: 79d4250d-18e4-4dbb-8925-50158775e0ac

	measure 'YoY Return pp' = ```
			
			 var ReturnRatePY = CALCULATE([Return Rate %], SAMEPERIODLASTYEAR('dim Calendar'[Date]))
			 Return 
			([Return Rate %] - ReturnRatePY)*100
			```
		displayFolder: Sales Analysis
		lineageTag: 59287dd6-754c-42f8-89a1-e9c1aa4ca242

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Discount Depth pp' = ```
			
			 var AvgDiscountPY = CALCULATE([Discount Depth], SAMEPERIODLASTYEAR('dim Calendar'[Date]))
			 Return 
			([Discount Depth] - AvgDiscountPY)*100
			```
		displayFolder: Sales Analysis
		lineageTag: 58149b1d-49a0-4349-b168-cd4e85f28108

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Subcategory Share' = ```
			
			VAR SelectedSubcategorySales = [Net Revenue] -- Current sales of subcotegory
			
			VAR TotalSales = 
			    CALCULATE(
			        [Net Revenue],
			        ALL('dim Product') -- Очищаем фильтр только с субкатегорий, сохраняя фильтр по странам
			    )
			
			RETURN 
			    DIVIDE(
			      SelectedSubcategorySales, 
			        TotalSales,
			        0
			   )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Sales Analysis
		lineageTag: 98ad0d91-e24b-4d29-8095-bf1928dfe4d3

	measure 'Units Sold' = SUMX('fact Sales','fact Sales'[SalesQuantity]-'fact Sales'[ReturnQuantity])
		formatString: 0
		displayFolder: Basic Sales measures
		lineageTag: 09e33100-edcf-45d5-8c27-80f711d8b7ca

	measure 'Total Inventory Value' = ```
			
			VAR _LastAvailDate = [Latest Snapshot Date]
			RETURN
			SUMX(
			    CALCULATETABLE(
			        'fact Inventory',
			        ALL('dim Calendar'), 'fact Inventory'[DateKey] = _LastAvailDate
			    ),
			    'fact Inventory'[OnHandQuantity] * 'fact Inventory'[UnitCost]
			)
			 
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Inventory
		lineageTag: a1c436be-4de2-4faf-996c-e6bdfbf733c4

	measure 'Latest Snapshot Date' = ```
			
			VAR MaxSelectedDate = MAX('dim Calendar'[Date])
			--  Inforce timestap for selected day as as 23:59:59 (To be able to work with latest inventory data available)
			VAR EndOfSelectedDay = TRUNC(MaxSelectedDate) + TIME(23, 59, 59) 
			RETURN
			CALCULATE(
			    MAX('fact Inventory'[DateKey]),
			    ALL('dim Calendar'),
			    'fact Inventory'[DateKey] <= EndOfSelectedDay
			)
			
			
			```
		formatString: General Date
		displayFolder: Inventory
		lineageTag: ae4525f6-9522-4ac7-a015-d607e4207e82

	measure 'Inventory Value Dynamics' = ```
			
			-- 1. Находим дату для каждой точки на оси графика
			VAR _CurrentDate = MAX('dim Calendar'[Date]) 
			
			RETURN
			-- 2. Считаем остатки строго на эту дату
			CALCULATE(
			    SUMX(
			        'fact Inventory', 
			        'fact Inventory'[OnHandQuantity] * 'fact Inventory'[UnitCost]
			    ),
			    'fact Inventory'[DateKey] = _CurrentDate
			)
			
			```
		formatString: #,0.###############\ "Br";-#,0.###############\ "Br";#,0.###############\ "Br"
		displayFolder: Inventory
		lineageTag: deeb7fdb-5865-49ff-b0c9-40879af4c26e

		annotation PBI_FormatHint = {"currencyCulture":"ru-BY"}

	measure 'Total Inventory PY' = ```
			
			VAR _LastAvailDate = [Latest Snapshot Date]-365
			RETURN
			SUMX(
			    CALCULATETABLE(
			        'fact Inventory',
			        ALL('dim Calendar'), 'fact Inventory'[DateKey] = _LastAvailDate
			    ),
			    'fact Inventory'[OnHandQuantity] * 'fact Inventory'[UnitCost]
			)
			 
			```
		formatString: #,0.###############\ "Br";-#,0.###############\ "Br";#,0.###############\ "Br"
		displayFolder: Inventory
		lineageTag: 12785c9e-0490-48bf-9f22-2f651ac8500f

		annotation PBI_FormatHint = {"currencyCulture":"ru-BY"}

	measure 'Avg Aging' = ```
			
			VAR _LastAvailDate = [Latest Snapshot Date] 
			RETURN
			CALCULATE(
			    AVERAGE('fact Inventory'[Aging]),
			    -- change of filter context (ignoring dimCalendar filter) and selection of one day
			    ALL('dim Calendar'), 
			    'fact Inventory'[DateKey] = _LastAvailDate
			)
			
			 
			```
		displayFolder: Inventory
		lineageTag: b979174b-bde0-43c6-8fc9-235232527467

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total COGS' = ```
			
			SUMX('fact Sales', 'fact Sales'[SalesQuantity] * 'fact Sales'[UnitCost]) 
			- SUMX('fact Sales', 'fact Sales'[ReturnQuantity] * 'fact Sales'[UnitCost])
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Inventory
		lineageTag: 750dc885-f17d-446f-9129-3fecadfc72d7

	measure 'Avg Inventory Value' = ```
			
			AVERAGEX(
			    VALUES('dim Calendar'[Date]),
			    [Total Inventory Value]
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Inventory
		lineageTag: 3bf8e9a2-25f1-4967-a017-96d4fdf17501

	measure 'Inventory Turnover Ratio' = ```
			
			DIVIDE(
			    [Total COGS],
			    [Avg Inventory Value],
			    BLANK()
			)
			
			```
		displayFolder: Inventory
		lineageTag: 6bd510e6-934c-4d4b-8378-9fe000bea3f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days Inventory' = ```
			
			-- How many days are in the filter context (1 day, month or year)
			VAR _DaysInPeriod = COUNTROWS(VALUES('dim Calendar'[Date])) 
			RETURN
			DIVIDE(
			    _DaysInPeriod, 
			    [Inventory Turnover Ratio],
			    BLANK()
			)
			
			```
		displayFolder: Inventory
		lineageTag: 22fd1015-a232-46a9-b21c-04dc4c46ed39

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scenario Net Revenue Price List Change' = sumx('fact Sales','fact Sales'[UnitPrice]*(1+ 'Scenario Price (%)'[Price adjustment (%) Value])*('fact Sales'[SalesQuantity]-'fact Sales'[ReturnQuantity]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Scenarios
