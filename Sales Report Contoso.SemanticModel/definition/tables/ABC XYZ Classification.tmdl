		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 037819cd-60fe-4199-8a02-90b348233127
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Revenue]

		annotation SummarizationSetBy = Automatic

	column 'StdDev Sales'
		formatString: 0.00
		lineageTag: 5aa904cc-eb77-4279-8f60-d2876aefebd6
		summarizeBy: sum
