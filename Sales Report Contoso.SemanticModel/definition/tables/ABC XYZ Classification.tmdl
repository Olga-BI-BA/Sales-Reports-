table 'ABC XYZ Classification'
	lineageTag: 46c3e3e4-9624-47e7-ace4-ee96c25eaed1

	column Year
		formatString: 0
		lineageTag: 53e98532-c732-4dc4-b0b4-01b0d66626b0
		summarizeBy: sum
		isNameInferred
		sourceColumn: dim Calendar[Year]

		annotation SummarizationSetBy = Automatic

	column ProductKey
		formatString: 0
		lineageTag: f9d345ac-e298-407d-a6e1-06d125398078
		summarizeBy: count
		isNameInferred
		sourceColumn: fact Sales[ProductKey]

		annotation SummarizationSetBy = Automatic

