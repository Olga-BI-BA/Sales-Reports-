		formatString: 0
		lineageTag: 65e775ee-2b56-4e08-9dd7-2f294b0b4ba2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Months With Sales]

		annotation SummarizationSetBy = Automatic

