model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Security tables
queryGroup 04_Support

	annotation PBI_QueryGroupOrder = 3

queryGroup 01_Fact

	annotation PBI_QueryGroupOrder = 1

queryGroup 00_Stage

	annotation PBI_QueryGroupOrder = 0

queryGroup 02_Dimentions

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim Product original","fact Sales","dim ProductSubcategory","dim ProductCategory","fact Sales 2024-2026","dim Calendar 2026 Model","dim Geo original","dim Customer","dim Store","dim Product","dim Geo","fact Inventory","dim SalesTerritory","dim Promotion","dim Channel","_Measures","dim Calendar","dim Currency","Security_Region_RLS","Security_Store_RLS"]

annotation PBI_ProTooling = ["CalcGroup","DaxQueryView_Desktop","DevMode"]

annotation __TEdtr = 1

ref table 'fact Sales'
ref table 'dim Store'
ref table 'fact Inventory'
ref table 'dim SalesTerritory'
ref table 'dim Promotion'
ref table 'dim Channel'
ref table _Measures
ref table 'dim Calendar'
ref table 'XYZ Classification'
ref table 'dim Currency'
ref table Security_Region_RLS
ref table Security_Store_RLS
ref table 'Scenario Price (%)'
ref table 'P_Core Metrics Selection'
ref table 'P_Product level'
ref table 'dim Product'
ref table 'dim Geo'
ref table P_Columns
ref table 'ABC XYZ Classification'
ref table 'Date Group'
ref table 'Metric Selection'
ref table 'Parameter Category- Country'
ref table 'Scenario Discount'
ref table 'Scenario Demand Increase'
ref table 'Scenario Unit Cost'
ref table 'Sales Elapsed Days'

ref role Continental_Region_access
ref role Store_access

ref cultureInfo en-US

